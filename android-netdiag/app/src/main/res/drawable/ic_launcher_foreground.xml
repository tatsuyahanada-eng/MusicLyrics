<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- NetScope glyph: a wireframe globe (network) being swept by a radar
         scan — reads as "network scanning" without needing a magnifying
         glass. Everything is kept inside the ~66dp safe-zone circle centred
         on (54,54) (radius 33) so it is never clipped by a round/squircle
         launcher mask — no border frame or bleeding handle this time. -->

    <!-- Globe outline -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#39FF6A"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M28,54 A26,26 0 1,0 80,54 A26,26 0 1,0 28,54 Z" />

    <!-- Meridian cross (reads as "globe/world") -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#22C55E"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:pathData="M54,28 L54,80" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#22C55E"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:pathData="M28,54 L80,54" />
    <!-- Narrow meridian arcs either side of centre, for globe depth -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#22C55E"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:pathData="M54,28 A13,26 0 0,0 54,80" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#22C55E"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:pathData="M54,28 A13,26 0 0,1 54,80" />

    <!-- Radar scan wedge (fading fill) + bright sweep line, origin at globe centre -->
    <path
        android:fillColor="#39FF6A"
        android:fillAlpha="0.20"
        android:pathData="M54,54 L54,28 A26,26 0 0,1 80,54 Z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#39FF6A"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M54,54 L80,54" />
    <path
        android:fillColor="#EAFFF3"
        android:pathData="M54,54m-3,0a3,3 0,1 1,6 0a3,3 0,1 1,-6 0" />

    <!-- Detected-device ping nodes on the globe -->
    <path android:fillColor="#39FF6A" android:fillAlpha="0.35"
        android:pathData="M35,40m-3.6,0a3.6,3.6 0,1 1,7.2 0a3.6,3.6 0,1 1,-7.2 0" />
    <path android:fillColor="#EAFFF3"
        android:pathData="M35,40m-2.2,0a2.2,2.2 0,1 1,4.4 0a2.2,2.2 0,1 1,-4.4 0" />

    <path android:fillColor="#39FF6A" android:fillAlpha="0.35"
        android:pathData="M40,72m-3.6,0a3.6,3.6 0,1 1,7.2 0a3.6,3.6 0,1 1,-7.2 0" />
    <path android:fillColor="#EAFFF3"
        android:pathData="M40,72m-2.2,0a2.2,2.2 0,1 1,4.4 0a2.2,2.2 0,1 1,-4.4 0" />
</vector>
