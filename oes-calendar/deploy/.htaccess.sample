# ------------------------------------------------------------------
# Basic認証のサンプル
#
# 1. このファイルを .htaccess にリネームして、index.html と同じ階層に置く
# 2. AuthUserFile は配置先サーバーの「絶対パス」に書き換える
# 3. .htpasswd は Web からアクセスできない場所に置くのが望ましい
#
#   .htpasswd の作り方（サーバー上で実行できる場合）
#     htpasswd -c /path/to/.htpasswd ユーザー名
#
#   ※ ユーザー名・パスワードはこのリポジトリに含めないこと
# ------------------------------------------------------------------

AuthType Basic
AuthName "OES Calendar"
AuthUserFile /path/to/.htpasswd
Require valid-user

# .htpasswd 自体へのアクセスを禁止する
<Files ".htpasswd">
    Require all denied
</Files>

# 設定ファイルへの直接アクセスを禁止する
# （config.php はPHPとして実行されるので中身は見えませんが、念のため）
<Files "config.php">
    Require all denied
</Files>

# manifest は manifest.json という名前にしてあるため、通常はMIMEタイプの設定は不要です。
# （.webmanifest だと未知の拡張子として扱うサーバーがあるため .json にしています）

# Service Worker はキャッシュさせない（更新が届かなくなるため）
<Files "sw.js">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache"
    </IfModule>
</Files>
